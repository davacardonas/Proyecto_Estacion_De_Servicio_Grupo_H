<section class="services container" id="servicios">
  <h2 class="section-heading"><span class="section-heading__bar"></span>{{services.heading}}</h2>

  <div class="services__grid">
    {{#each services.items}}
    <article class="service-card service-card--{{this.image}}" id="{{this.id}}">
      <div class="service-card__scrim"></div>
      <div class="service-card__body">
        <h3 class="service-card__title">{{icon this.icon}}{{this.name}}</h3>
        <p class="service-card__desc">{{this.description}}</p>
        <a class="service-card__link" href="#{{this.id}}">{{this.cta}} <span aria-hidden="true">→</span></a>
      </div>
    </article>
    {{/each}}
  </div>
</section>
