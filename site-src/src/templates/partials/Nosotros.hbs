<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nosotros · {{site.title}}</title>
    <meta name="description" content="Conoce la historia de Texaco Centro de Servicio en Teupasenti: nuestra misión, visión, la biografía de nuestro fundador Don Amaya y los valores que nos definen desde hace más de 25 años.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

{{> header nav=nav site=site}}

<main>

<section class="page-hero">
    <span class="page-hero__eyebrow">{{nosotros.eyebrow}}</span>

    <h1 class="page-hero__title">
        {{nosotros.title}}
    </h1>

    <p class="page-hero__subtitle">
        {{nosotros.subtitle}}
    </p>
</section>

<section class="about-company container">

    <div class="about-company__content">

        <h2 class="section-heading">
            <span class="section-heading__bar"></span>
            {{nosotros.heading}}
        </h2>

        <p>{{nosotros.paragraph1}}</p>

        <p>{{nosotros.paragraph2}}</p>

    </div>

    <div class="about-company__stats">

        {{#each nosotros.stats}}

        <article class="stat-card">

            <h3>{{this.value}}</h3>

            <p>{{this.label}}</p>

        </article>

        {{/each}}

    </div>

</section>

<section class="mission container">

    <div class="mission__card">

        <h2>{{nosotros.mission.title}}</h2>

        <p>{{nosotros.mission.text}}</p>

    </div>

    <div class="mission__card">

        <h2>{{nosotros.vision.title}}</h2>

        <p>{{nosotros.vision.text}}</p>

    </div>

</section>

<section class="about-gallery">

    <h2 class="about-gallery__title">{{nosotros.gallery.heading}}</h2>

    <div class="about-gallery__grid">

        {{#each nosotros.gallery.items}}

        <figure class="about-gallery__item">
            <img src="{{this.image}}" alt="{{this.caption}} · Texaco Centro de Servicio Teupasenti" loading="lazy">
            <figcaption>{{this.caption}}</figcaption>
        </figure>

        {{/each}}

    </div>

</section>

<section class="founder" id="fundador">

    <div class="container founder__inner">

        <div class="founder__media">
            <img
                src="{{nosotros.founder.image}}"
                alt="Retrato de {{nosotros.founder.name}}, fundador de Texaco Centro de Servicio"
                class="founder__image"
                loading="lazy"
            >
        </div>

        <div class="founder__body">

            <span class="founder__eyebrow">{{nosotros.founder.eyebrow}}</span>
            <h2 class="founder__heading">{{nosotros.founder.heading}}</h2>

            <p class="founder__name">{{nosotros.founder.name}}</p>
            <p class="founder__role">{{nosotros.founder.role}}</p>

            <p>{{nosotros.founder.bio}}</p>
            <p>{{nosotros.founder.bio2}}</p>

            <p class="founder__quote">&ldquo;{{nosotros.founder.quote}}&rdquo;</p>

        </div>

    </div>

</section>

<section class="values container" id="valores">

    <h2 class="section-heading values__heading">
        <span class="section-heading__bar"></span>
        {{nosotros.values.heading}}
    </h2>

    <p class="values__subtitle">{{nosotros.values.subtitle}}</p>

    <div class="values__grid">

        {{#each nosotros.values.items}}

        <article class="value-card">
            <span class="value-card__icon">{{icon this.icon}}</span>
            <h3 class="value-card__name">{{this.name}}</h3>
            <p class="value-card__desc">{{this.description}}</p>
        </article>

        {{/each}}

    </div>

</section>

</main>

{{> footer footer=footer}}

<button class="help-fab" type="button">?</button>
  {{> site-scripts}}

</body>
</html>