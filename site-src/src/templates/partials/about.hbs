<section class="about container">
  <div class="about__text">
    <h2 class="section-heading"><span class="section-heading__bar"></span>{{about.heading}}</h2>
    {{#each about.paragraphs}}
    <p>{{this}}</p>
    {{/each}}
  </div>

  <div class="about__stats">
    {{#each about.stats}}
    <div class="stat">
      <p class="stat__value">{{this.value}}</p>
      <p class="stat__label">{{this.label}}</p>
    </div>
    {{/each}}
  </div>
</section>
