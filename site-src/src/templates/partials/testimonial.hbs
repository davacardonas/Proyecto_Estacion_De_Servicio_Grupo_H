<section class="testimonial">
  <div class="container testimonial__grid">
    <div class="testimonial__content">
      <span class="testimonial__quote-mark" aria-hidden="true">&rdquo;</span>
      <p class="testimonial__text">{{testimonial.quote}}</p>
      <div class="testimonial__author">
        <span class="testimonial__avatar">{{testimonial.authorInitial}}</span>
        <span>
          <span class="testimonial__name">{{testimonial.authorName}}</span>
          <span class="testimonial__role">{{testimonial.authorRole}}</span>
        </span>
      </div>
    </div>

    <div class="testimonial__media">
      <div class="testimonial__image"></div>
      <div class="testimonial__badge">{{testimonial.badge}}</div>
    </div>
  </div>
</section>
