<section class="promo">
  <div class="container promo__inner">
    <div class="promo__text">
      <p class="promo__eyebrow">{{promo.eyebrow}}</p>
      <h2 class="promo__heading">{{promo.heading}}<br>{{promo.headingLine2}}</h2>
      <p class="promo__desc">{{promo.description}}</p>
    </div>
    <a class="btn btn--light" href="{{promo.cta.href}}">{{promo.cta.label}}</a>
  </div>
</section>
