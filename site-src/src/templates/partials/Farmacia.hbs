<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmacia · {{site.title}}</title>
    <meta name="description"
        content="Medicamentos, vitaminas y productos de cuidado personal en la farmacia del Texaco Centro de Servicio, Teupasenti, El Paraíso.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    {{> header nav=nav site=site}}

    <main>
        <section class="page-hero page-hero--farmacia">
            <span class="page-hero__eyebrow">{{farmacia.eyebrow}}</span>
            <h1 class="page-hero__title">{{farmacia.title}}</h1>
            <p class="page-hero__subtitle">{{farmacia.subtitle}}</p>
        </section>

        <section class="hours" id="farmacia-categorias">
            <div class="container">
                <h2 class="section-heading"><span class="section-heading__bar"></span>{{farmacia.categoriesHeading}}
                </h2>
            </div>
            <div class="container hours__grid">
                {{#each farmacia.categories}}
                <div class="hours__item">
                    <span class="hours__icon">{{icon this.icon}}</span>
                    <span class="hours__text">
                        <span class="hours__name">{{this.name}}</span>
                        <span class="hours__schedule">{{this.description}}</span>
                    </span>
                </div>
                {{/each}}
            </div>
        </section>

        <section class="promo farmacia-banner">
            <div class="promo__inner">
                <div>
                    <span class="promo__eyebrow">{{farmacia.hours.heading}}</span>
                    <p class="promo__desc">{{farmacia.hours.paragraph}}</p>
                </div>
                <ul class="farmacia-banner__meta">
                    <li>{{icon "clock"}}{{farmacia.hours.schedule}}</li>
                    <li>{{icon "pin"}}{{farmacia.hours.reference}}</li>
                    <li>{{icon "phone"}}{{farmacia.hours.phone}}</li>
                    <li>{{icon "cart"}}{{farmacia.hours.delivery}}</li>
                </ul>
            </div>
        </section>

        <section class="farmacia-why" id="farmacia-confianza">
            <div class="container">
                <h2 class="section-heading"><span class="section-heading__bar"></span>{{farmacia.trust.heading}}
                </h2>
                <div class="farmacia-why__grid">
                    {{#each farmacia.trust.items}}
                    <article class="why-card">
                        <span class="why-card__icon">{{icon this.icon}}</span>
                        <p class="why-card__name">{{this.name}}</p>
                        <p class="why-card__desc">{{this.schedule}}</p>
                    </article>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="farmacia-mission" id="farmacia-mision">
            <div class="container farmacia-mission__inner">
                <div class="farmacia-mission__text">
                    <span class="farmacia-mission__eyebrow">{{farmacia.mission.eyebrow}}</span>
                    <h2 class="farmacia-mission__heading">{{farmacia.mission.heading}}</h2>
                    <p>{{farmacia.mission.paragraph1}}</p>
                    <p>{{farmacia.mission.paragraph2}}</p>
                    <ul class="farmacia-mission__list">
                        {{#each farmacia.mission.highlights}}
                        <li>{{icon "cross"}}{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                <div class="farmacia-mission__media">
                    <img 
                        src="https://images.unsplash.com/photo-1642055514517-7b52288890ec?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
                        alt="Imagen de la farmacia" 
                        class="farmacia-mission__image"
                    >
                </div>
            </div>
        </section>

        <section class="farmacia-brands" id="farmacia-marcas">
            <div class="container">
                <h2 class="section-heading"><span class="section-heading__bar"></span>{{farmacia.brands.heading}}
                </h2>
                <p class="farmacia-brands__subtitle">{{farmacia.brands.subtitle}}</p>
                <div class="farmacia-brands__grid">
                    {{#each farmacia.brands.items}}
                    <span class="brand-chip">{{this}}</span>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="farmacia-services" id="farmacia-servicios">
            <div class="container">
                <h2 class="section-heading"><span class="section-heading__bar"></span>{{farmacia.services.heading}}
                </h2>
                <div class="farmacia-services__grid">
                    {{#each farmacia.services.items}}
                    <article class="service-item">
                        <span class="service-item__icon">{{icon this.icon}}</span>
                        <div class="service-item__body">
                            <p class="service-item__name">{{this.name}}</p>
                            <p class="service-item__desc">{{this.description}}</p>
                        </div>
                    </article>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="farmacia-products" id="farmacia-promociones">
            <div class="container">
                <h2 class="section-heading"><span class="section-heading__bar"></span>{{farmacia.products.heading}}
                </h2>

                <div class="farmacia-products__grid">
                    {{#each farmacia.products.items}}
                    <article class="product-card">
                        <div class="product-card__media">
                            <span class="product-card__badge">{{this.badge}}</span>
                            
                            <img class="product-card__img" src="{{this.image}}" alt="{{this.name}}" loading="lazy">
                        </div>
                        <div class="product-card__body">
                            <p class="product-card__name">{{this.name}}</p>
                            <p class="product-card__brand">{{this.brand}}</p>
                            <p class="product-card__note">{{this.note}}</p>
                        </div>
                    </article>
                    {{/each}}
                </div>
            </div>
        </section>

        <section class="farmacia-pharmacist" id="farmacia-equipo">
            <div class="container">
                <h2 class="section-heading farmacia-pharmacist__heading"><span class="section-heading__bar"></span>{{farmacia.pharmacist.eyebrow}}
                </h2>
                <div class="pharmacist-card">
                    <div class="pharmacist-card__avatar">
                        <img 
                        src="https://images.unsplash.com/photo-1712215544003-af10130f8eb3?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
                        alt="Imagen de la farmacia" 
                        class="farmacia-mission__image"
                        >
                    </div>
                    <div class="pharmacist-card__body">
                        <p class="pharmacist-card__name">{{farmacia.pharmacist.name}}</p>
                        <p class="pharmacist-card__role">{{farmacia.pharmacist.role}}</p>
                        <p class="pharmacist-card__bio">{{farmacia.pharmacist.bio}}</p>
                        <p class="pharmacist-card__quote">&ldquo;{{farmacia.pharmacist.quote}}&rdquo;</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {{> footer footer=footer}}

    <button class="help-fab" type="button" aria-label="Ayuda">?</button>
  {{> site-scripts}}
</body>

</html>

