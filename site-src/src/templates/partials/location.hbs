<section class="location container" id="ubicacion">
  <h2 class="section-heading"><span class="section-heading__bar"></span>{{location.heading}}</h2>

  <div class="location__grid">
    <div class="location__card">
      <p class="location__eyebrow">{{location.eyebrow}}</p>
      <p class="location__address">
        {{#each location.addressLines}}
        {{this}}<br>
        {{/each}}
      </p>

      <ul class="location__meta">
        <li>{{icon "pin"}}{{location.reference}}</li>
        <li>{{icon "phone"}}{{location.phone}}</li>
        <li>{{icon "mail"}}{{location.email}}</li>
      </ul>

      <a class="btn btn--primary" href="{{location.cta.href}}">{{location.cta.label}} <span aria-hidden="true">→</span></a>
    </div>

    <div class="location__map">
      <a class="location__map-badge" href="{{location.cta.href}}" target="_blank" rel="noopener">{{location.mapsLabel}} <span aria-hidden="true">↗</span></a>
      <iframe class="location__map-canvas" src="{{location.mapEmbedUrl}}" title="Mapa de ubicación de Texaco Centro de Servicio en Teupasenti, El Paraíso" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0;"></iframe>
    </div>
  </div>
</section>
