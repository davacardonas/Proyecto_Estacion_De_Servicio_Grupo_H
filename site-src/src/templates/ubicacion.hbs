<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ubicación · {{site.title}}</title>
  <meta name="description"
    content="Encontranos en la vía principal de Teupasenti, El Paraíso, Honduras. Mapa, dirección, teléfono y cómo llegar al Texaco Centro de Servicio.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  {{> header nav=nav site=site}}

  <main>
    <section class="page-hero">
      <span class="page-hero__eyebrow">CÓMO LLEGAR</span>
      <h1 class="page-hero__title">NUESTRA UBICACIÓN</h1>
      <p class="page-hero__subtitle">Estamos en la vía principal de Teupasenti, El Paraíso. Fácil de encontrar, con
        acceso directo desde la carretera.</p>
    </section>

    <section class="location" id="ubicacion">
      <div class="location__grid">
        <div class="location__card">
          <p class="location__eyebrow">{{location.eyebrow}}</p>
          <p class="location__address">
            {{#each location.addressLines}}
            {{this}}<br>
            {{/each}}
          </p>

          <ul class="location__meta">
            <li>{{icon "pin"}}{{location.reference}}</li>
            <li>{{icon "phone"}}{{location.phone}}</li>
            <li>{{icon "mail"}}{{location.email}}</li>
          </ul>

          <p class="location__hours">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            Abierto 24 horas · todos los días
          </p>

          <div class="location__actions">
            <a class="btn btn--primary" href="{{location.cta.href}}" target="_blank" rel="noopener">{{location.cta.label}}
              <span aria-hidden="true">→</span></a>

            <a class="btn btn--wa" href="https://wa.me/50422001234?text=Hola,%20quiero%20informacion%20sobre%20la%20estacion" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm5.4 14.2c-.2.6-1.2 1.1-1.7 1.2-.4.1-1 .1-1.6-.1-1.9-.6-3.2-1.9-4.5-3.6-.4-.6-.9-1.4-.9-2.2 0-.8.4-1.2.6-1.4.2-.2.4-.2.5-.2h.4c.1 0 .3 0 .5.4l.6 1.5c.1.1.1.3 0 .4l-.3.4c-.1.1-.2.3-.1.5.3.5.7 1 1.2 1.4.5.4 1 .6 1.3.7.2.1.4.1.5-.1l.5-.6c.1-.2.3-.2.5-.1l1.4.7c.2.1.3.2.4.3 0 .2 0 .6-.1.9z"/></svg>
              WhatsApp
            </a>

            <a class="btn btn--call" href="tel:+50422001234">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/></svg>
              Llamar
            </a>
          </div>
        </div>

        <div class="location__map">
          <a class="location__map-badge" href="{{location.cta.href}}" target="_blank"
            rel="noopener">{{location.mapsLabel}} <span aria-hidden="true">↗</span></a>
          <iframe class="location__map-frame" src="{{location.mapEmbedUrl}}"
            title="Mapa de ubicación de Texaco Centro de Servicio en Teupasenti" loading="lazy"
            referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <section class="location-nearby">
      <h2 class="location-nearby__title">Puntos de referencia cercanos</h2>
      <ul class="location-nearby__list">
        <li class="location-nearby__item">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
          Frente al Parque Dr. Gerónimo Murillo
        </li>
        <li class="location-nearby__item">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
          A pocos metros del Cementerio Municipal
        </li>
        <li class="location-nearby__item">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
          Cerca de la Misión Rescatando La Niñez
        </li>
        <li class="location-nearby__item">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
          Sobre la vía principal, junto al Río Jalán
        </li>
      </ul>
    </section>

    <section class="location-gallery">
      <h2 class="location-gallery__title">Conocé el lugar</h2>
      <div class="location-gallery__grid">
        <figure class="location-gallery__item">
          <img src="/images/teupasenti-pueblo.jpg" alt="Vista del pueblo de Teupasenti, El Paraíso, donde se ubica la estación">
          <figcaption>Teupasenti, El Paraíso</figcaption>
        </figure>
        <figure class="location-gallery__item">
          <img src="/images/servicio-gasolinera.jpg" alt="Estación de servicio Texaco en Teupasenti">
          <figcaption>Nuestra estación de servicio</figcaption>
        </figure>
      </div>
    </section>
  </main>

  {{> footer footer=footer}}

  <button class="help-fab" type="button" aria-label="Ayuda">?</button>
  {{> site-scripts}}
</body>

</html>